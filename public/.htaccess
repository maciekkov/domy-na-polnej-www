Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
FileETag MTime Size

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Stable filenames can change. A cached image/document must be revalidated.
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|gif|avif|mp4|woff2|woff|pdf|css|js|xml|txt)$">
    Header set Cache-Control "public, no-cache, max-age=0, must-revalidate"
  </FilesMatch>
  # Never let an old offer/route configuration survive a release.
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

RewriteEngine On
RewriteBase /
# Hidden files/configuration are never public; .well-known remains available for TLS.
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ - [R=404,L]
