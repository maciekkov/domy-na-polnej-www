    "dev:admin": "node scripts/dev-admin.mjs",
    "assets:check": "node scripts/asset-inventory.mjs",
    "assets:version": "node scripts/version-assets.mjs",
    "predev": "node scripts/version-assets.mjs && node scripts/generate-seo.mjs",
    "prebuild": "node scripts/version-assets.mjs && node scripts/generate-seo.mjs",
    "content:publish": "node scripts/publish-site-data.mjs",
    "test:dist": "node tests/dist-check.mjs",
    "test:syntax": "node tests/syntax-check.mjs",
