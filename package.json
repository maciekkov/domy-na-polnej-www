    "@playwright/test": "^1.55.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.2",
    "vite": "7.1.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
